PORT=5001
# Email provider: smtp or resend. Resend avoids SMTP port/network restrictions.
EMAIL_PROVIDER=smtp

# Gmail SMTP (dynamic user credentials are entered in the app).
# Gmail App Password must be 16 characters; spaces are removed automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Port 465 uses implicit TLS. Ports 587 and 2525 use STARTTLS automatically.
SMTP_SECURE=true
# Optional fallback credentials. Normal users configure SMTP in the app.
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=5000
SMTP_SOCKET_TIMEOUT=10000

# Resend HTTP API fallback (set EMAIL_PROVIDER=resend to use it).
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=verified-sender@your-domain.com

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
